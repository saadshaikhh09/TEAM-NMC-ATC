# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=postgresql://concierge:concierge@localhost:5432/concierge

# --- Flight status (Person B) -------------------------------------------
# AeroDataBox is PRIMARY: richer status vocabulary, 5 req/sec.
# AviationStack is SECONDARY / cross-check only.
# BOTH ARE CAPPED AT 500 REQUESTS PER MONTH. Read core/quota.py before you
# write a single call. Thirty rehearsals will exhaust these if you are careless.
AERODATABOX_API_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
AVIATIONSTACK_API_KEY=
# AviationStack HTTPS was verified with this project's key. Backend only;
# the key is a query parameter, so never log the request URL.
AVIATIONSTACK_BASE=https://api.aviationstack.com/v1

# --- Flight search + booking, test mode (Person D) ----------------------
DUFFEL_API_KEY=
DUFFEL_API_VERSION=v2

# --- Hotel: real sandbox lifecycle (Person D) ---------------------------
# LiteAPI / Nuitee sandbox. Full prebook -> book -> cancel, free, no card.
NUITEE_API_KEY=
NUITEE_BASE=https://api.liteapi.travel/v3.0

# --- LLM sidecar (Person A) ---------------------------------------------
# Ordered fallback chain. Tried left to right; first success wins.
# If every provider fails or times out, llm/fallback.py templated strings are
# used and the demo continues. The LLM is off the critical path by design —
# this chain buys quota headroom and latency, not correctness.
#
# A name in this chain with no registered adapter is SKIPPED, not an error
# (router.py:120), so it is safe to list groq before its key is filled in.
LLM_CHAIN=groq,xkiro,openrouter

LLM_TIMEOUT_SECONDS=4        # per provider. 3 providers = 12s worst case.
LLM_TOTAL_BUDGET_SECONDS=8   # router gives up and uses fallback past this.
LLM_BREAKER_COOLDOWN=60      # skip a provider for N sec after it fails

# Cache LLM responses by plan hash. Thirty rehearsals of the same plan should
# cost ONE call, not thirty. Leave this on.
LLM_CACHE=true

# groq — PRIMARY. OpenAI-compatible, so it uses the generic adapter in
# llm/providers/openai_compatible.py; there is no groq-specific file.
# Get a key at https://console.groq.com/keys — it starts with `gsk_`.
#
# GROQ_MODEL IS DELIBERATELY BLANK. Do not paste a model name from memory —
# Groq retires them. List what your key can actually reach first:
#
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY" | python3 -m json.tool
#
# then pick a fast production chat model from that output. Both the key and
# the model must be set or the provider is not registered at all.
GROQ_API_KEY=
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# gemini — DROPPED. The configured key was an `AQ.` OAuth token, not an
# `AIza…` Generative Language key, so it 404'd in 0.49s on every call while
# sitting first in the chain. Deleted rather than fixed: groq covers this slot.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# openrouter — LAST RESORT. The configured free model answered correctly but
# took 31.7s against a 4s per-provider timeout, so in practice it always times
# out. It is in the chain as a third parachute, not as a working provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# xkiro — verify at hour 0 whether it is OpenAI-compatible (POST
# {base}/chat/completions with a Bearer token). If it is, the generic adapter
# works untouched and you only fill these in. If it is not, write a small
# adapter in llm/providers/ and register it in the router. Do NOT spend more
# than 20 minutes on this — two providers is already enough.
XKIRO_API_KEY=
XKIRO_BASE=
XKIRO_MODEL=

# --- Demo controls -------------------------------------------------------
# DEMO_MODE=true means NO live status API is ever called. Mock only.
# This is a quota guard, not a convenience. Leave it true by default.
DEMO_MODE=true
DEMO_POLL_SECONDS=15
PROVIDER_FLIGHT_STATUS=mock     # mock | aerodatabox | aviationstack
PROVIDER_FLIGHT_SEARCH=mock     # mock | duffel
PROVIDER_HOTEL=mock             # mock | nuitee

# Hard monthly ceilings. core/quota.py refuses the call when these are hit.
QUOTA_AERODATABOX_MONTHLY=500
QUOTA_AVIATIONSTACK_MONTHLY=500
# Leave headroom for the live demo run. Development stops at this fraction.
QUOTA_DEV_BUDGET_FRACTION=0.4
