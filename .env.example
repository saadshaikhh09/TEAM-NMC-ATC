# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=postgresql://concierge:concierge@localhost:5432/concierge

# --- Flight status (Person B) -------------------------------------------
# AeroDataBox is PRIMARY: richer status vocabulary, 5 req/sec.
# AviationStack is SECONDARY / cross-check only.
# BOTH ARE CAPPED AT 500 REQUESTS PER MONTH. Read core/quota.py before you
# write a single call. Thirty rehearsals will exhaust these if you are careless.
AERODATABOX_API_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
AVIATIONSTACK_API_KEY=
# AviationStack free tier is HTTP ONLY — the key travels in plaintext.
# Never call it from the browser. Backend only.
AVIATIONSTACK_BASE=http://api.aviationstack.com/v1

# --- Flight search + booking, test mode (Person D) ----------------------
DUFFEL_API_KEY=
DUFFEL_API_VERSION=v2

# --- Hotel: real sandbox lifecycle (Person D) ---------------------------
# LiteAPI / Nuitee sandbox. Full prebook -> book -> cancel, free, no card.
NUITEE_API_KEY=
NUITEE_BASE=https://api.liteapi.travel/v3.0

# --- LLM sidecar (Person A) ---------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Demo controls -------------------------------------------------------
# DEMO_MODE=true means NO live status API is ever called. Mock only.
# This is a quota guard, not a convenience. Leave it true by default.
DEMO_MODE=true
DEMO_POLL_SECONDS=15
PROVIDER_FLIGHT_STATUS=mock     # mock | aerodatabox | aviationstack
PROVIDER_FLIGHT_SEARCH=mock     # mock | duffel
PROVIDER_HOTEL=mock             # mock | nuitee

# Hard monthly ceilings. core/quota.py refuses the call when these are hit.
QUOTA_AERODATABOX_MONTHLY=500
QUOTA_AVIATIONSTACK_MONTHLY=500
# Leave headroom for the live demo run. Development stops at this fraction.
QUOTA_DEV_BUDGET_FRACTION=0.4
